    },
    "The service could not be reached. Check the connection and try again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst war nicht erreichbar. Prüfe die Verbindung und versuche es erneut."
          }
        }
      }
    },
    "The service returned no leagues." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Dienst hat keine Ligen geliefert."
          }
        }
      }
    },
    "The source has no programme information for it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Quelle hat dazu keine Programminformationen."
          }
        }
      }
    },
    "The sports hub shows today's football matches and the channel of your playlist that has them. It uses your own free account at sportapi.ai: enter its key here. The free plan allows 2,000 requests a day." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Sport-Bereich zeigt die heutigen Fußballspiele und den Sender deiner Playlist, der sie zeigt. Er nutzt dein eigenes, kostenloses Konto bei sportapi.ai: Gib hier dessen Schlüssel ein. Der kostenlose Tarif erlaubt 2.000 Anfragen am Tag."
          }
        }
      }
    },
    "The table could not be loaded." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Tabelle konnte nicht geladen werden."
          }
