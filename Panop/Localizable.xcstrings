    "Suggestions": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge"
          }
        }
      }
    },
    "Suggestions are chosen on this device from your own library and what you watch. What is trending is Simkl's public list, fetched the same way for everyone. Nothing about you or what you watch is sent.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschläge werden auf diesem Gerät aus deiner eigenen Mediathek und dem, was du schaust, ausgewählt. Was beliebt ist, kommt aus der öffentlichen Liste von Simkl, die für alle gleich abgerufen wird. Über dich oder das, was du schaust, wird nichts gesendet."
          }
        }
      }
    },
    "TV guide address (optional)": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse des Programmführers (optional)"
          }
        }
      }
    },
    "Tap a programme to watch it from the start.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf eine Sendung, um sie von Anfang an zu sehen."
          }
        }
      }
    },
    "That file could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht gelesen werden."
          }
        }
      }
    },
    "That is not a valid web address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige Webadresse."
          }
