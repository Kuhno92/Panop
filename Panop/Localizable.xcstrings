    "The provider did not return any channels, movies or series." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Anbieter hat keine Sender, Filme oder Serien geliefert."
          }
        }
      }
    },
    "The provider has nothing at that address (404)." : {
      "localizations" : {
