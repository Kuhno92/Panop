          "stringUnit": {
            "state": "translated",
            "value": "Danke an"
          }
        }
      }
    },
    "That file could not be read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht gelesen werden."
          }
        }
      }
    },
    "That is not a valid web address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige Webadresse."
          }
        }
      }
