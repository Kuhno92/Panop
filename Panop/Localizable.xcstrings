    },
    "Teams of leagues with a table show up here. Choose a league first." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teams von Ligen mit Tabelle erscheinen hier. Wähle zuerst eine Liga."
          }
