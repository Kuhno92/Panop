            "value" : "Der Programmführer hat ein Format, das Panop nicht versteht."
          }
        }
      }
    },
    "The two did not match. Choose a PIN again." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die beiden stimmten nicht überein. Wähle die PIN erneut."
          }
        }
      }
    },
    "The VPN did not answer. Panop is not connecting." : {
      "extractionState" : "manual",
