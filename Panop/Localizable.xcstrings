    "The TV guide could not be loaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Programmführer konnte nicht geladen werden."
          }
        }
      }
    },
    "The TV guide download was damaged, so it was not used.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download des Programmführers war beschädigt und wurde nicht verwendet."
          }
        }
      }
    },
    "The TV guide is not in a format Panop understands.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Programmführer hat ein Format, das Panop nicht versteht."
          }
        }
      }
    },
    "The address is kept in the Keychain, because it often contains your login. If the playlist names its own TV guide, you do not need to fill this in.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse wird im Schlüsselbund gespeichert, weil sie oft deine Anmeldedaten enthält. Wenn die Playlist ihren eigenen Programmführer nennt, musst du das hier nicht ausfüllen."
          }
        }
      }
    },
    "The available players can't open this stream's format.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die verfügbaren Player können das Format dieses Streams nicht öffnen."
          }
        }
      }
    },
    "The channel starts playing as soon as Panop opens, from what is already on this device.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Sender startet, sobald Panop sich öffnet, aus dem, was schon auf diesem Gerät ist."
          }
        }
      }
    },
    "The channels you watch show up here.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sender, die du schaust, erscheinen hier."
          }
        }
      }
    },
    "The code ran out before it was approved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Code ist abgelaufen, bevor er bestätigt wurde."
          }
        }
      }
    },
    "The download was cut off, so nothing was changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Download wurde abgebrochen, daher wurde nichts geändert."
          }
        }
      }
    },
    "The login details could not be saved to the Keychain.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldedaten konnten nicht im Schlüsselbund gespeichert werden."
