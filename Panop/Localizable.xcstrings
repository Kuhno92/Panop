    "The TV guide address is not a valid web address.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse des Programmführers ist keine gültige Webadresse."
          }
        }
      }
    },
    "The TV guide could not be downloaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Programmführer konnte nicht heruntergeladen werden."
