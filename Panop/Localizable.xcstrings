        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der VPN-Server"
          }
        }
      }
    },
    "Their names belong to their authors. Panop is not affiliated with or endorsed by any of them." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Namen gehören ihren Urhebern. Panop ist weder mit ihnen verbunden noch von ihnen empfohlen."
          }
        }
      }
    },
    "This build of Panop cannot use iCloud, so playlists have to be added here." : {
      "localizations" : {
        "de" : {
