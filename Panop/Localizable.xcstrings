    "That is not a valid web address. It should start with http:// or https://.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist keine gültige Webadresse. Sie sollte mit http:// oder https:// beginnen."
