<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Panop is always signed and uploaded under the personal team, never the company one. -->
	<key>teamID</key>
	<string>4HUJUM5AUG</string>
	<key>method</key>
	<string>app-store-connect</string>
	<!-- "upload" sends the build to App Store Connect (TestFlight) as it exports; "export" only writes the file. -->
	<key>destination</key>
	<string>upload</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
