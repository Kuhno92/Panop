# SwiftFormat runs before SwiftLint in the pre-commit hook and owns whitespace
# and brace placement. Anything SwiftLint would fight over is disabled there.
--swiftversion 6.3
--trailing-commas never
--maxwidth 120
--wraparguments before-first
--wrapparameters before-first
--wrapcollections preserve
--indent 4
--self remove
--stripunusedargs closure-only
--exclude .build,reference,vendor,Packages/*/.build
